{
  "manifest_version": 3,
  "name": "SimVisão - Simulador de Deficiências Visuais",
  "version": "0.3.0",
  "description": "Simula daltonismo, baixa visão e visão em túnel em qualquer site, em tempo real, e verifica problemas de acessibilidade durante o desenvolvimento web.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SimVisão - Simulador de Deficiências Visuais",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}